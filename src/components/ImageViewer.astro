---
import Icon from './Icon.astro';
---

<dialog id="image-viewer" class="image-viewer" aria-label="查看文章图片">
  <button class="viewer-close" type="button" data-image-close aria-label="关闭大图">
    <Icon name="close" /> <span>关闭</span>
  </button>
  <figure>
    <img data-viewer-image alt="" />
    <figcaption data-viewer-caption></figcaption>
  </figure>
</dialog>
<style>
  .image-viewer {
    width: 100%;
    max-width: 100%;
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    border: 0;
    background: transparent;
    color: #fff;
    padding: calc(
        max(var(--space-4), env(safe-area-inset-top, 0px)) + var(--control-size) + var(--space-4)
      )
      var(--space-5) max(var(--space-6), env(safe-area-inset-bottom, 0px));
  }
  .image-viewer::backdrop {
    background: #101914f5;
  }
  .image-viewer figure {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    min-height: 0;
    margin: 0;
    gap: var(--space-4);
    pointer-events: none;
  }
  .image-viewer figure img {
    max-width: min(100%, 90rem);
    max-height: calc(100dvh - var(--space-9) - var(--space-8));
    min-height: 0;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
    pointer-events: auto;
  }
  .image-viewer figcaption {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: #d1d9d2;
    max-width: 75ch;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .viewer-close {
    position: absolute;
    right: max(var(--space-5), env(safe-area-inset-right, 0px));
    top: max(var(--space-4), env(safe-area-inset-top, 0px));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: var(--control-size);
    min-height: var(--control-size);
    padding: var(--space-2) var(--space-4);
    background: #ffffff12;
    border: 1px solid #ffffff30;
    border-radius: var(--radius-control);
    font-size: var(--text-sm);
    transition: background-color var(--duration-fast);
  }
  .viewer-close:hover {
    background: #ffffff24;
  }
  .viewer-close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: var(--space-1);
  }
  @media (max-width: 640px) {
    .image-viewer {
      padding-inline: max(var(--space-3), env(safe-area-inset-left, 0px))
        max(var(--space-3), env(safe-area-inset-right, 0px));
    }
    .viewer-close {
      right: max(var(--space-4), env(safe-area-inset-right, 0px));
    }
  }
</style>
