---
import Icon from './Icon.astro';
---

<dialog id="image-viewer" class="image-viewer" aria-label="查看文章图片">
  <button class="viewer-close" type="button" data-image-close aria-label="关闭大图">
    <Icon name="close" /> <span>关闭</span>
  </button>
  <figure>
    <img data-viewer-image alt="" />
    <figcaption data-viewer-caption></figcaption>
  </figure>
</dialog>
<style>
  .image-viewer {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    border: 0;
    background: transparent;
    color: #fff;
    padding: 65px 24px 30px;
  }
  .image-viewer::backdrop {
    background: #101914f5;
  }
  .image-viewer figure {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    gap: 18px;
    pointer-events: none;
  }
  .image-viewer figure img {
    max-width: min(100%, 1440px);
    max-height: calc(100dvh - 150px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    pointer-events: auto;
  }
  .image-viewer figcaption {
    font-size: 13px;
    color: #d1d9d2;
    max-width: 75ch;
    text-align: center;
  }
  .viewer-close {
    position: absolute;
    right: 24px;
    top: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    background: #ffffff12;
    border: 1px solid #ffffff30;
    border-radius: 8px;
    font-size: 12px;
  }
  @media (max-width: 640px) {
    .image-viewer {
      padding-inline: 12px;
    }
    .viewer-close {
      right: 16px;
    }
  }
</style>
