---
import { site } from '../config/site';
import { presentation } from '../config/presentation';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
const current = Astro.url.pathname;
interface Props {
  section?: string;
}
const { section } = Astro.props;
function currentSection(path: string) {
  if (current === withBase(path)) return 'page';
  if (path === 'music/' && current.startsWith(withBase('music/scores/'))) return undefined;
  if (path && (path === section || current.startsWith(withBase(path)))) return 'location';
  return undefined;
}
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase()} aria-label={`${site.title} 首页`}>
      <span class="brand-mark">
        <img
          class={presentation.navbar.logo === site.avatar ? 'avatar-portrait-image' : undefined}
          src={withBase(presentation.navbar.logo)}
          alt=""
          width="36"
          height="36"
          decoding="async"
        />
      </span>
      <span>
        <span class="brand-name">{presentation.navbar.title}</span>
      </span>
    </a>
    <div class="header-tools">
      <details class="site-directory" data-site-directory>
        <summary class="directory-toggle">
          <Icon name="menu" size={18} />
          <span>目录</span>
        </summary>
        <nav class="directory-panel" aria-label="站点目录">
          {presentation.navbar.links.map(({ label, items }) => (
            <div class="directory-group">
              <p>{label}</p>
              <ul>
                {items.map(({ label: name, path }) => (
                  <li>
                    <a href={withBase(path)} aria-current={currentSection(path)}>
                      {name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </details>
      <a
        class="icon-button search-trigger"
        href={withBase('search/')}
        aria-label="搜索文章"
        aria-keyshortcuts="Control+k Meta+k"
        title="搜索文章（Ctrl / ⌘ K）"
        data-search-open
      >
        <Icon name="search" />
        <kbd data-search-shortcut>Ctrl K</kbd>
      </a>
      <button class="icon-button" type="button" data-theme-toggle aria-label="切换深色模式">
        <Icon name="moon" class="theme-moon" />
        <Icon name="sun" class="theme-sun" />
      </button>
      <button
        class="icon-button"
        type="button"
        data-appearance-open
        aria-label="打开外观设置"
        aria-haspopup="dialog"
        aria-controls="appearance-settings"
        hidden
      >
        <Icon name="palette" />
      </button>
    </div>
  </div>
</header>
