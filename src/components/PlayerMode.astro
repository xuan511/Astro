---
import Icon from './Icon.astro';
import { playModes, modeLabels } from '../lib/player-state';
interface Props {
  id: string;
  compact?: boolean;
  describedBy?: string;
}
const { id, compact = false, describedBy } = Astro.props;
---

<label class:list={['player-mode', { 'mini-mode': compact }]} for={id}>
  <span class="sr-only">播放模式</span>
  <span data-mode-icon="sequence">
    <Icon name="list" size={16} />
  </span>
  <span data-mode-icon="repeat-one" hidden>
    <Icon name="repeat" size={16} />
  </span>
  <span data-mode-icon="shuffle" hidden>
    <Icon name="shuffle" size={16} />
  </span>
  <select
    {id}
    data-player-mode-select
    aria-label={compact ? '迷你播放器播放模式' : '音乐房间播放模式'}
    aria-describedby={describedBy}
  >
    {playModes.map((mode) => (
      <option value={mode}>{modeLabels[mode]}</option>
    ))}
  </select>
  <Icon name="chevron" size={12} class="mode-chevron" />
</label>
