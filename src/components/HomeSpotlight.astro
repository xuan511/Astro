---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Media from './Media.astro';
import { postPath, formatDate } from '../lib/paths';
interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
---

<section class="glass-card home-spotlight" aria-labelledby="spotlight-heading" data-spotlight>
  <h2 class="sr-only" id="spotlight-heading">
    值得翻开的记录
  </h2>
  <div class="spotlight-slides" aria-live="polite">
    {posts.map((post, index) => (
      <article
        class="spotlight-slide"
        data-spotlight-slide
        hidden={index !== 0}
        aria-label={`第 ${index + 1} 篇精选，共 ${posts.length} 篇`}
      >
        <a href={postPath(post.id)}>
          <Media
            src={post.data.cover || 'images/coastal-summer.webp'}
            alt={post.data.coverAlt || '夏日海湾插画'}
            width={760}
            height={500}
            eager={index === 0}
          />
          <div class="spotlight-caption">
            <div>
              <span class="spotlight-category">{post.data.category}</span>
              <time datetime={post.data.publishedAt.toISOString()}>
                {formatDate(post.data.publishedAt)}
              </time>
              {post.data.demo && <span class="spotlight-demo">示例</span>}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="spotlight-read">
              翻开这篇记录 <Icon name="arrow" size={16} />
            </span>
          </div>
        </a>
      </article>
    ))}
  </div>
  {posts.length > 1 && (
    <div class="spotlight-controls" data-spotlight-controls hidden>
      <button class="icon-button" type="button" data-spotlight-prev aria-label="上一篇精选">
        <Icon name="prev" size={16} />
      </button>
      <div class="spotlight-dots" role="group" aria-label="选择精选记录">
        {posts.map((post, index) => (
          <button
            type="button"
            data-spotlight-index={index}
            aria-pressed={index === 0}
            aria-label={`查看精选 ${index + 1}：${post.data.title}`}
          >
            <span></span>
          </button>
        ))}
      </div>
      <output data-spotlight-count>01 / {String(posts.length).padStart(2, '0')}</output>
      <button class="icon-button" type="button" data-spotlight-next aria-label="下一篇精选">
        <Icon name="next" size={16} />
      </button>
    </div>
  )}
</section>
<script>
  import '../scripts/spotlight';
</script>
