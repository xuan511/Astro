---
import Icon from './Icon.astro';
---

<div class="reading-controls" aria-label="阅读设置">
  <div class="reading-size-controls" role="group" aria-label="正文字号">
    <span>字号</span>
    <button type="button" data-reading-smaller aria-label="缩小正文字号 A−">
      A−
    </button>
    <output data-reading-size-label aria-live="polite">
      标准
    </output>
    <button type="button" data-reading-larger aria-label="放大正文字号 A＋">
      A＋
    </button>
  </div>
  <button class="reading-width-control" type="button" data-reading-width aria-pressed="false">
    <Icon name="width" size={16} />
    <span>宽屏阅读</span>
  </button>
  <button class="reading-share" type="button" data-copy-article>
    <Icon name="link" size={16} />
    <span>复制链接</span>
  </button>
  <span class="sr-only" data-reading-feedback role="status"></span>
</div>
<style>
  .reading-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    padding: var(--space-3) 0;
    margin: 0 0 var(--space-6);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .reading-size-controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .reading-size-controls > span {
    margin-right: var(--space-1);
  }
  .reading-controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-size);
    gap: var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    padding: var(--space-2);
    transition:
      color var(--duration-fast),
      background-color var(--duration-fast),
      border-color var(--duration-fast);
  }
  .reading-controls button:hover:not(:disabled),
  .reading-controls button[aria-pressed='true'] {
    background: var(--soft);
    color: var(--accent);
  }
  .reading-controls button[aria-pressed='true'] {
    border-color: var(--accent);
    font-weight: 600;
  }
  .reading-controls button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .reading-size-controls button {
    font-size: var(--text-sm);
    min-width: var(--control-size);
  }
  .reading-size-controls output {
    min-width: 2em;
    text-align: center;
  }
  .reading-share {
    margin-left: auto;
  }
  @media (max-width: 68rem) {
    .reading-width-control {
      display: none !important;
    }
  }
  @media (max-width: 40rem) {
    .reading-controls {
      gap: var(--space-2);
      margin-bottom: var(--space-5);
    }
    .reading-size-controls {
      gap: var(--space-1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-controls button {
      transition: none;
    }
  }
</style>
