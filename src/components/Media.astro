---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../lib/paths';
interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  eager?: boolean;
}
const { src, alt, width = 960, height = 600, class: cls, eager = false } = Astro.props;
---

{typeof src === 'string' ? (
  <img
    src={withBase(src)}
    alt={alt}
    width={width}
    height={height}
    class={cls}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
) : (
  <Image
    src={src}
    alt={alt}
    width={width}
    widths={[480, 960]}
    sizes="(max-width: 680px) 100vw, 760px"
    class={cls}
    loading={eager ? 'eager' : 'lazy'}
  />
)}
