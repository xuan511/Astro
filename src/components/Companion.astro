---
import Icon from './Icon.astro';
import catalog from '../data/companions.json';
import { withBase } from '../lib/paths';
import '../styles/companion.css';
const companions = catalog.map((item) => ({ ...item, image: withBase(item.image) }));
const first = companions[0];
---

<aside
  id="site-companion"
  class="companion"
  data-companion-root
  transition:persist="shijian-companion"
  aria-label="页面小伙伴"
  hidden
>
  <p class="companion-bubble" data-companion-bubble role="status" aria-live="polite" hidden></p>
  <div class="companion-full" data-companion-full>
    <button
      class="companion-avatar"
      type="button"
      data-companion-greet
      aria-label={`和${first.name}打招呼；可拖动，方向键移动，Home 复位`}
      aria-describedby="companion-help"
    >
      <span class="companion-sparkles" aria-hidden="true">
        ✧
      </span>
      <img
        src={first.image}
        alt={first.name}
        width="256"
        height="320"
        draggable="false"
        decoding="async"
        data-companion-image
      />
    </button>
    <div class="companion-toolbar">
      <button
        class="icon-button"
        type="button"
        data-companion-picker
        aria-label="选择小伙伴"
        aria-haspopup="dialog"
        aria-controls="companion-picker"
      >
        <Icon name="sparkles" size={18} />
      </button>
      <button class="icon-button" type="button" data-companion-compact aria-label="收起小伙伴">
        <Icon name="chevron" size={18} />
      </button>
    </div>
  </div>
  <button
    class="companion-pocket"
    type="button"
    data-companion-expand
    aria-label={`展开小伙伴：${first.name}`}
    hidden
  >
    <img
      src={first.image}
      alt=""
      width="64"
      height="80"
      draggable="false"
      decoding="async"
      data-companion-image
    />
    <span class="companion-pocket-dot" aria-hidden="true"></span>
  </button>
  <span id="companion-help" class="sr-only">
    点击角色听一句鼓励。拖动角色可移动位置；键盘方向键移动，Home
    键复位。星星按钮可换角色、安静陪伴或隐藏。
  </span>
  <script
    type="application/json"
    data-companion-catalog
    set:html={JSON.stringify(companions).replaceAll('<', '\\u003c')}
  />
  <dialog id="companion-picker" class="companion-picker" aria-labelledby="companion-picker-title">
    <div class="companion-picker-heading">
      <div>
        <p class="eyebrow">A LITTLE COMPANY</p>
        <h2 id="companion-picker-title">今天想和谁作伴？</h2>
      </div>
      <button class="icon-button" type="button" data-companion-close aria-label="关闭角色选择">
        <Icon name="close" />
      </button>
    </div>
    <p class="companion-picker-note">选一位小伙伴，陪你慢慢读。点击她，会收到一句小小的鼓励。</p>
    <div class="companion-choices" aria-label="选择陪伴角色">
      {companions.map((item) => (
        <button
          class="companion-choice"
          type="button"
          data-companion-choice={item.id}
          aria-pressed={item.id === first.id}
        >
          <img src={item.image} alt="" width="120" height="150" loading="lazy" decoding="async" />
          <strong>{item.name}</strong>
          <small>{item.work}</small>
        </button>
      ))}
    </div>
    <div class="companion-options">
      <label>
        <input type="checkbox" data-companion-quiet /> 安静陪伴，减少角色动作
      </label>
      <p>角色可以拖动；手机默认收起。隐藏后可从页脚「小伙伴」找回来。</p>
      <div>
        <button class="button secondary" type="button" data-companion-reset>
          位置复位
        </button>
        <button class="button secondary" type="button" data-companion-hide>
          隐藏小伙伴
        </button>
      </div>
    </div>
  </dialog>
</aside>
<script>
  import '../scripts/companion';
</script>
