---
import Icon from './Icon.astro';
import catalog from '../data/companions.json';
import { withBase } from '../lib/paths';
import '../styles/companion.css';
const companions = catalog.map((item) => ({ ...item, image: withBase(item.image) }));
const first = companions[0];
---

<aside
  id="site-companion"
  class="companion"
  data-companion-root
  transition:persist="shijian-companion"
  aria-label="亚托莉陪伴"
  hidden
>
  <p class="companion-bubble" data-companion-bubble role="status" aria-live="polite" hidden></p>
  <div class="companion-full" data-companion-full>
    <button
      class="companion-avatar"
      type="button"
      data-companion-greet
      aria-label="和亚托莉互动"
      aria-describedby="companion-help"
    >
      <span class="companion-figure" data-companion-figure>
        <img
          src={first.image}
          alt="亚托莉"
          width="256"
          height="320"
          loading="lazy"
          fetchpriority="low"
          draggable="false"
          decoding="async"
          data-companion-image
        />
      </span>
      <span class="companion-effects" data-companion-effects aria-hidden="true"></span>
    </button>
    <div class="companion-toolbar">
      <button
        class="icon-button"
        type="button"
        data-companion-picker
        aria-label="亚托莉设置"
        aria-haspopup="dialog"
        aria-controls="companion-picker"
      >
        <Icon name="sparkles" size={18} />
      </button>
      <button
        class="icon-button"
        type="button"
        data-companion-pet
        aria-label="摸摸亚托莉的头"
        title="摸摸头"
      >
        <Icon name="heart" size={18} />
      </button>
      <button class="icon-button" type="button" data-companion-compact aria-label="收起小伙伴">
        <Icon name="chevron" size={18} />
      </button>
    </div>
  </div>
  <button
    class="companion-pocket"
    type="button"
    data-companion-expand
    aria-label="展开小伙伴：亚托莉"
    hidden
  >
    <img
      src={first.image}
      alt=""
      width="64"
      height="80"
      loading="lazy"
      fetchpriority="low"
      draggable="false"
      decoding="async"
      data-companion-image
    />
    <span class="companion-pocket-dot" aria-hidden="true"></span>
  </button>
  <span id="companion-help" class="sr-only">
    点击亚托莉会有不同的小动作，连续点三下有彩蛋。长按或点爱心可以摸摸头。拖动角色可移动位置；键盘方向键移动，Home
    键复位。星星按钮可设置安静陪伴、位置复位或隐藏。
  </span>
  <script
    type="application/json"
    data-companion-catalog
    set:html={JSON.stringify(companions).replaceAll('<', '\\u003c')}
  />
  <dialog id="companion-picker" class="companion-picker" aria-labelledby="companion-picker-title">
    <div class="companion-picker-heading">
      <div>
        <h2 id="companion-picker-title">亚托莉的陪伴设置</h2>
      </div>
      <button class="icon-button" type="button" data-companion-close aria-label="关闭陪伴设置">
        <Icon name="close" />
      </button>
    </div>
    <div class="atri-identity">
      <img src={first.image} alt="" width="72" height="90" loading="lazy" decoding="async" />
      <div>
        <strong>亚托莉</strong>
      </div>
    </div>
    <div class="companion-options">
      <label>
        <input type="checkbox" data-companion-quiet />
        安静陪伴
      </label>
      <p>隐藏后从页脚「亚托莉」唤回。</p>
      <div>
        <button class="button" type="button" data-companion-reset>
          位置复位
        </button>
        <button class="button" type="button" data-companion-hide>
          隐藏小伙伴
        </button>
      </div>
    </div>
  </dialog>
</aside>
<script>
  import '../scripts/companion';
</script>
