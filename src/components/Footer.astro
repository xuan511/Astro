---
import { site } from '../config/site';
import { withBase } from '../lib/paths';
import footerHtml from '../config/footer.html?raw';
import { presentation } from '../config/presentation';
import VisitCount from './VisitCount.astro';
---

<footer class="site-footer shell">
  {!presentation.footer.replaceDefault && (
    <>
      <p>
        © {new Date().getFullYear()} {site.author} · {site.title}
      </p>
      <nav aria-label="页脚导航">
        <a href={withBase('archive/')}>归档</a>
        <a href={withBase('rss.xml')}>RSS</a>
        <a href={withBase('writing/')}>写作指南</a>
      </nav>
    </>
  )}
  {footerHtml.trim() && <div class="footer-custom" set:html={footerHtml} />}
  <div class="footer-statistics">
    <VisitCount metric="site_pv" label="访问" />
    <VisitCount metric="site_uv" label="访客" unit="位" />
    <a href={withBase('stats/')}>访问统计</a>
    <span class="sr-only" data-visit-status role="status" aria-live="polite">
      正在读取访问统计
    </span>
  </div>
  <button class="companion-show" type="button" data-companion-show hidden>
    亚托莉
  </button>
</footer>
