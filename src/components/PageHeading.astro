---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="page-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {description && <p class="page-description">{description}</p>}
  <slot />
</header>
