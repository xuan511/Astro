---
import { ClientRouter } from 'astro:transitions';
import type { Props as SeoProps } from '../components/SeoHead.astro';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.astro';
import QuickSearch from '../components/QuickSearch.astro';
import Companion from '../components/Companion.astro';
import Appearance from '../components/Appearance.astro';
import { displayBootstrap } from '../lib/layout-preferences';
import { presentation, appearanceDefaults } from '../config/presentation';
import { withBase } from '../lib/paths';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../config/site';
import { themeBootstrap } from '../lib/theme-preferences';
import '../styles/global.css';
import '../styles/shell.css';
import '../styles/layout.css';
interface Props extends SeoProps {
  section?: string;
}
const {
  title,
  description = site.description,
  noindex = false,
  image,
  ogType = 'website',
  section,
} = Astro.props;
const preferenceKey = `shijian:${import.meta.env.BASE_URL}:theme-v3`;
const readingKey = `shijian:${import.meta.env.BASE_URL}:reading-v1`;
const appearanceKey = `shijian:${import.meta.env.BASE_URL}:appearance-v1`;
const isPost = ogType === 'article';
const isHome = Astro.url.pathname === withBase();
const fontCss = presentation.fonts
  .filter((font) => font.source)
  .map(
    (font) =>
      `@font-face{font-family:${JSON.stringify(font.family)};src:url(${JSON.stringify(withBase(font.source!))}) format('woff2');font-display:swap}`,
  )
  .join('');
const pageMotion = {
  old: { name: 'page-leave', duration: '0ms', easing: 'ease-out', fillMode: 'both' },
  new: {
    name: 'page-enter',
    duration: '120ms',
    easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
    fillMode: 'both',
  },
} as const;
---

<!doctype html>
<html
  lang="zh-CN"
  data-theme="light"
  data-sidebar={appearanceDefaults.sidebar}
  data-layout={appearanceDefaults.layout}
  data-wallpaper={appearanceDefaults.wallpaper}
  data-scene={appearanceDefaults.scene}
  data-solid="false"
  data-font={appearanceDefaults.font}
  style={`--theme-hue:${appearanceDefaults.hue};--site-font:${presentation.fonts.find((font) => font.id === appearanceDefaults.font)?.family}`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <SeoHead {title} {description} {noindex} {image} {ogType} />
    {isHome && (
      <meta name="google-site-verification" content="rsewA-R6CZpQvEXXO9iinn4m2JOPSnRIr76kWaWB2wU" />
    )}
    <script is:inline set:html={themeBootstrap(preferenceKey, site.defaultTheme)} />
    <script
      is:inline
      set:html={displayBootstrap(appearanceKey, appearanceDefaults, presentation.fonts)}
    />
    <style is:inline set:html={fontCss} />
    <script is:inline define:vars={{ readingKey }}>
      try {
        const reading = JSON.parse(localStorage.getItem(readingKey) || '{}');
        document.documentElement.dataset.readingSize = ['small', 'normal', 'large'].includes(
          reading?.size,
        )
          ? reading.size
          : 'normal';
        document.documentElement.dataset.readingWide = String(reading?.wide === true);
      } catch {
        /* Default typography remains readable without storage. */
      }
    </script>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body data-base={import.meta.env.BASE_URL} data-default-theme={site.defaultTheme}>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <Header section={section} />
    <div class:list={['wallpaper-banner', 'shell', { 'is-home': isHome }]} aria-hidden="true">
      <img
        src={withBase(presentation.wallpaper.image)}
        alt=""
        width="1600"
        height="900"
        fetchpriority={isHome ? 'high' : 'auto'}
      />
      <span>在日常里，收藏微光。</span>
    </div>
    <div
      class="site-layout shell"
      data-page-kind={isPost ? 'post' : 'page'}
      data-tablet-sidebar={presentation.sidebar.tablet}
    >
      <aside class="layout-sidebar sidebar-left" aria-label="个人资料与小站导航">
        <div class="sidebar-stack">
          <Sidebar side="left" />
        </div>
      </aside>
      <main
        id="main"
        class="site-main"
        tabindex="-1"
        transition:name="page-content"
        transition:animate={{ forwards: pageMotion, backwards: pageMotion }}
      >
        <slot />
      </main>
      <aside
        class="layout-sidebar sidebar-right"
        aria-label={isPost ? '文章目录与辅助信息' : '分类与最近更新'}
      >
        <div class="sidebar-stack">
          <slot name="sidebar-right">
            <Sidebar side="right" />
          </slot>
        </div>
      </aside>
    </div>
    <Footer />
    <Player />
    <QuickSearch />
    <Companion />
    <Appearance />
    <div id="site-announcement" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
