---
import { ClientRouter } from 'astro:transitions';
import type { Props as SeoProps } from '../components/SeoHead.astro';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.astro';
import QuickSearch from '../components/QuickSearch.astro';
import { site } from '../config/site';
import { themeBootstrap } from '../lib/theme-preferences';
import '../styles/global.css';
interface Props extends SeoProps {
  section?: string;
}
const {
  title,
  description = site.description,
  noindex = false,
  image,
  ogType = 'website',
  section,
} = Astro.props;
const preferenceKey = `shijian:${import.meta.env.BASE_URL}:theme-v3`;
const readingKey = `shijian:${import.meta.env.BASE_URL}:reading-v1`;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <SeoHead {title} {description} {noindex} {image} {ogType} />
    <script is:inline set:html={themeBootstrap(preferenceKey, site.defaultTheme)} />
    <script is:inline define:vars={{ readingKey }}>
      try {
        const reading = JSON.parse(localStorage.getItem(readingKey) || '{}');
        document.documentElement.dataset.readingSize = ['small', 'normal', 'large'].includes(
          reading?.size,
        )
          ? reading.size
          : 'normal';
        document.documentElement.dataset.readingWide = String(reading?.wide === true);
      } catch {
        /* Default typography remains readable without storage. */
      }
    </script>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body data-base={import.meta.env.BASE_URL} data-default-theme={site.defaultTheme}>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <Header section={section} />
    <main id="main" tabindex="-1" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <Player />
    <QuickSearch />
    <div id="site-announcement" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
