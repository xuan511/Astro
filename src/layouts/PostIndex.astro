---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import PageHeading from '../components/PageHeading.astro';
import PostCard from '../components/PostCard.astro';
import { taxonomyPath, withBase } from '../lib/paths';
import { groupPostsByTaxonomy } from '../lib/post-query';
interface Props {
  title: string;
  eyebrow: string;
  description: string;
  posts: CollectionEntry<'posts'>[];
  kind?: 'tech' | 'life';
  section?: string;
}
const { title, eyebrow, description, posts, kind, section } = Astro.props;
const categories = groupPostsByTaxonomy(posts, 'category');
const tags = groupPostsByTaxonomy(posts, 'tags');
---

<Base title={title} description={description} section={section}>
  <div class:list={['shell', 'post-index', { 'life-index': kind === 'life' }]}>
    <PageHeading title={title} eyebrow={eyebrow} description={description} />
    <div class="index-layout">
      <section aria-label="文章列表">
        <nav class="filter-links" aria-label="文章分类">
          <a class="pill" href={withBase('archive/')}>
            全部归档
          </a>
          {categories.map(({ name }) => (
            <a class="pill" href={taxonomyPath('categories', name)}>
              {name}
            </a>
          ))}
          <span class="count">{posts.length} 篇记录</span>
        </nav>
        {posts.map((post) => (
          <PostCard post={post} heading="h2" />
        ))}
        {posts.length === 0 && (
          <div class="empty-state">
            <h2>这里还很安静。</h2>
            <p>新的记录会从下一次落笔开始。</p>
          </div>
        )}
      </section>
      <aside class="index-aside">
        <h2 class="aside-title">沿着标签，继续翻翻</h2>
        <nav class="tag-cloud" aria-label="文章标签">
          {tags.map(({ name }) => (
            <a href={taxonomyPath('tags', name)}>#{name}</a>
          ))}
        </nav>
        <p class="handwritten">
          Take your time.
          <br />
          Enjoy the reading.
        </p>
      </aside>
    </div>
  </div>
</Base>
<style>
  .index-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--layout-toc);
    gap: var(--space-7);
    align-items: start;
  }
  .index-layout > * {
    min-width: 0;
  }
  .tag-cloud {
    display: flex;
    gap: var(--space-1) var(--space-3);
    flex-wrap: wrap;
    color: var(--body);
    font-size: var(--text-sm);
  }
  .tag-cloud a {
    min-width: 0;
    max-width: 100%;
    min-height: var(--control-size);
    padding-block: var(--space-2);
    overflow-wrap: anywhere;
    transition: color var(--duration-fast);
  }
  .tag-cloud a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .index-aside {
    padding-top: var(--space-3);
  }
  .life-index :global(.post-card-link) {
    padding-block: var(--space-6);
  }
  .life-index :global(.excerpt) {
    line-height: var(--leading-reading);
    -webkit-line-clamp: 3;
  }
  .life-index :global(.post-mark) {
    background: var(--sand);
  }
  @media (max-width: 56.25rem) {
    .index-layout {
      display: block;
    }
    .index-aside {
      margin-top: var(--space-7);
      border-top: 1px solid var(--line);
      padding-top: var(--space-5);
    }
    .life-index :global(.post-card-link) {
      padding-block: var(--space-5);
    }
  }
</style>
