---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import PageHeading from '../components/PageHeading.astro';
import PostFeed from '../components/PostFeed.astro';
import { taxonomyPath, withBase } from '../lib/paths';
import { groupPostsByTaxonomy } from '../lib/post-query';
interface Props {
  title: string;
  description: string;
  posts: CollectionEntry<'posts'>[];
  kind?: 'tech' | 'life' | 'log';
  section?: string;
}
const { title, description, posts, section } = Astro.props;
const categories = groupPostsByTaxonomy(posts, 'category');
---

<Base title={title} description={description} section={section}>
  <div class="post-index">
    <div class="index-heading">
      <PageHeading title={title} />
      <nav class="filter-links" aria-label="文章分类">
        <a class="pill" href={withBase('archive/')}>
          全部归档
        </a>
        {categories.map(({ name }) => (
          <a class="pill" href={taxonomyPath('categories', name)}>
            {name}
          </a>
        ))}
      </nav>
    </div>
    <section aria-label="文章列表">
      <PostFeed posts={posts} />
      {posts.length === 0 && (
        <div class="empty-state">
          <h2>暂无文章</h2>
        </div>
      )}
    </section>
  </div>
</Base>
<style>
  .index-heading {
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-lg);
    background: var(--glass);
    padding: 0 var(--space-5);
    margin-bottom: var(--space-5);
  }
  .index-heading :global(.page-heading) {
    margin-bottom: var(--space-4);
    padding-top: var(--space-5);
  }
</style>
