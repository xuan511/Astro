---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';
---

<Base title="资源下载" description="软件下载与版本记录。" section="resources/">
  <div class="shell resource-page">
    <h1>资源下载</h1>
    <section class="resource-card" aria-labelledby="qingyi-title">
      <h2 id="qingyi-title">轻译 v2.1</h2>
      <p>取词翻译工具，支持本地英文 OCR。</p>
      <p class="muted">Windows 11 x64 · ZIP · 4.68 MB</p>
      <p>完整解压后运行 <code>QuietTranslate.exe</code>。</p>
      <div>
        <a class="button primary" href={withBase('downloads/QuietTranslate-win11-x64-v2.1.zip')} download>
          下载轻译 v2.1
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .resource-page {
    max-width: var(--layout-content);
    padding-block: var(--space-7);
  }

  .resource-card {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-lg);
    background: var(--reading-paper);
    box-shadow: var(--shadow-card);
  }
</style>
