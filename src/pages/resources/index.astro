---
import Base from '../../layouts/Base.astro';
---

<Base title="资源下载" description="拾间的软件下载与版本记录。" section="resources/">
  <div class="shell resource-page">
    <h1>资源下载</h1>
    <section class="resource-card" aria-labelledby="qingyi-title">
      <h2 id="qingyi-title">轻译</h2>
      <p>Windows 取词翻译工具。</p>
      <p class="muted">安装包待上传</p>
    </section>
  </div>
</Base>

<style>
  .resource-page {
    max-width: var(--layout-content);
    padding-block: var(--space-7);
  }

  .resource-card {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-lg);
    background: var(--reading-paper);
    box-shadow: var(--shadow-card);
  }
</style>
