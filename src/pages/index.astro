---
import Base from '../layouts/Base.astro';
import PostFeed from '../components/PostFeed.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { withBase } from '../lib/paths';
import { publishedPosts } from '../lib/content';
import { getCollection } from 'astro:content';
import '../styles/home.css';
const posts = await publishedPosts();
const projects = (await getCollection('projects')).filter((project) => project.data.featured);
---

<Base description={site.homeDescription}>
  <div class="home-journal" data-home-dashboard>
    <header class="journal-intro glass-card">
      <p class="eyebrow">{site.hero.note}</p>
      <h1>{site.hero.title.replace('\n', '')}</h1>
      <p>{site.description}</p>
      <a
        class="journal-search"
        href={withBase('search/')}
        data-search-open
        aria-label="搜索文章、项目与随记"
      >
        <Icon name="search" size={18} />
        <span>搜索代码、日常，或一个新想法</span>
        <kbd data-search-shortcut>Ctrl K</kbd>
      </a>
    </header>
    <section id="latest" aria-labelledby="latest-heading">
      <div class="section-heading">
        <h2 id="latest-heading">最近的记录</h2>
        <a class="text-link" href={withBase('archive/')}>
          全部归档
        </a>
      </div>
      <nav class="journal-collections" aria-label="文章栏目">
        <a href={withBase('tech/')}>
          <Icon name="code" size={16} />
          技术
        </a>
        <a href={withBase('log/')}>日志</a>
        <a href={withBase('life/')}>
          <Icon name="leaf" size={16} />
          生活
        </a>
        <a href={withBase('music/scores/')}>
          <Icon name="music" size={16} />
          琴谱
        </a>
      </nav>
      <PostFeed posts={posts} />
    </section>
    <section class="journal-projects" aria-labelledby="projects-heading">
      <div class="section-heading">
        <h2 id="projects-heading">把想法做出来</h2>
        <a class="text-link" href={withBase('projects/')}>
          所有项目
        </a>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    </section>
  </div>
</Base>
