---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HomeMusic from '../components/HomeMusic.astro';
import HomeSpotlight from '../components/HomeSpotlight.astro';
import { site } from '../config/site';
import { withBase, formatDate } from '../lib/paths';
import { publishedPosts, recentNotes } from '../lib/content';
import { getCollection } from 'astro:content';
import '../styles/home.css';
const posts = await publishedPosts();
const notes = await recentNotes();
const allProjects = await getCollection('projects');
const projects = allProjects.filter((project) => project.data.featured).slice(0, 2);
const featured = [
  ...posts.filter((post) => post.data.featured),
  ...posts.filter((post) => !post.data.featured),
].slice(0, 4);
---

<Base>
  <div class="shell home-dashboard" data-home-dashboard>
    <div class="home-welcome">
      <p>
        <span aria-hidden="true">✦</span> 把热爱，藏进每个日常。
      </p>
      <a href={withBase('rss.xml')}>
        订阅拾间 <Icon name="arrow" size={14} />
      </a>
    </div>
    <a
      class="glass-card home-search"
      href={withBase('search/')}
      data-search-open
      aria-label="搜索文章、项目与随记"
      aria-keyshortcuts="Control+k Meta+k"
    >
      <Icon name="search" size={22} />
      <span>
        想找点什么？<small>搜索代码、日常，或一个新想法</small>
      </span>
      <kbd data-search-shortcut>Ctrl K</kbd>
      <span class="home-search-arrow">
        <Icon name="arrow" size={18} />
      </span>
    </a>
    <div class="home-top-grid">
      <section class="glass-card home-profile" aria-labelledby="home-title">
        <div class="home-profile-head">
          <a href={withBase('about/')} aria-label={`了解 ${site.author}`}>
            <img src={withBase(site.avatar)} alt={`${site.author} 的头像`} width="66" height="66" />
          </a>
          <div>
            <p>
              {site.author}
              <span class="profile-status">在自己的节奏里</span>
            </p>
            <small>欢迎来到拾间，一处慢慢生长的小角落。</small>
          </div>
          <Icon name="sparkles" size={26} />
        </div>
        <h1 id="home-title">{site.hero.title}</h1>
        <p class="home-profile-bio">{site.description} 把好奇心留给每一天。</p>
        <div class="home-profile-bottom">
          <nav class="home-stats" aria-label="小站内容">
            <a href={withBase('archive/')}>
              <strong>{posts.length}</strong>
              <span>篇记录</span>
            </a>
            <a href={withBase('notes/')}>
              <strong>{notes.length}</strong>
              <span>则随记</span>
            </a>
            <a href={withBase('projects/')}>
              <strong>{allProjects.length}</strong>
              <span>个项目</span>
            </a>
          </nav>
          <a
            class="profile-social icon-button"
            href={site.social[0]?.url || withBase('about/')}
            aria-label="访问 GitHub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="code" size={22} />
          </a>
        </div>
      </section>
      <HomeMusic />
    </div>
    <div class="home-middle-grid">
      {featured.length > 0 ? (
        <HomeSpotlight posts={featured} />
      ) : (
        <section class="glass-card home-empty">
          <Icon name="book" size={36} />
          <h2>故事，正要开始。</h2>
          <p>新的记录会慢慢出现在这里。</p>
        </section>
      )}
      <div class="home-small-grid">
        <section class="glass-card home-note" aria-labelledby="home-note-title">
          <div class="tile-heading">
            <h2 id="home-note-title">
              <Icon name="leaf" size={17} /> 随手记下
            </h2>
            <a class="icon-button" href={withBase('notes/')} aria-label="查看所有随记">
              <Icon name="arrow" size={17} />
            </a>
          </div>
          {notes[0] ? (
            <a
              href={withBase('notes/')}
              class="home-note-body"
              aria-label={`阅读随记：${notes[0].data.body}`}
            >
              <blockquote>{notes[0].data.body}</blockquote>
              <span>
                <time datetime={notes[0].data.date.toISOString()}>
                  {formatDate(notes[0].data.date)}
                </time>
                {notes[0].data.demo && <small>示例随记</small>}
              </span>
            </a>
          ) : (
            <p class="muted">给下一次灵感，留一点空白。</p>
          )}
          <span class="note-decoration" aria-hidden="true">
            ”
          </span>
        </section>
        <section class="glass-card home-atmosphere" aria-labelledby="home-atmosphere-title">
          <div class="tile-heading">
            <h2 id="home-atmosphere-title">属于你的阅读空间</h2>
            <button
              class="icon-button"
              type="button"
              data-appearance-open
              aria-label="打开外观设置"
              aria-haspopup="dialog"
              aria-controls="appearance-settings"
              hidden
            >
              <Icon name="palette" size={19} />
            </button>
          </div>
          <p>海风、微光，或一页安静的纸。</p>
          <div class="scene-options home-scene-options" role="group" aria-label="首页背景选择">
            <button type="button" data-scene-choice="coast" aria-pressed="true">
              <span class="scene-swatch scene-swatch-coast" aria-hidden="true"></span>海边夏日
            </button>
            <button type="button" data-scene-choice="mist" aria-pressed="false">
              <span class="scene-swatch scene-swatch-mist" aria-hidden="true"></span>云间微光
            </button>
            <button type="button" data-scene-choice="paper" aria-pressed="false">
              <span class="scene-swatch scene-swatch-paper" aria-hidden="true"></span>专注阅读
            </button>
          </div>
        </section>
      </div>
    </div>
    <section id="latest" class="home-latest" aria-labelledby="latest-heading">
      <div class="section-heading">
        <h2 id="latest-heading">
          <Icon name="book" size={20} /> 最近的记录 <small>LATEST STORIES</small>
        </h2>
        <a class="text-link" href={withBase('archive/')}>
          全部归档 <Icon name="arrow" size={15} />
        </a>
      </div>
      <nav class="home-collections" aria-label="文章栏目">
        <a href={withBase('tech/')}>
          <Icon name="code" size={15} /> 技术与折腾
        </a>
        <a href={withBase('life/')}>
          <Icon name="leaf" size={15} /> 生活与片刻
        </a>
        <span>{posts.length} 篇记录 · 慢慢积累</span>
      </nav>
      <div class="home-post-grid">
        {posts.slice(0, 4).map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
    <section class="home-projects" aria-labelledby="projects-heading">
      <div class="section-heading">
        <h2 id="projects-heading">
          <Icon name="code" size={20} /> 把想法做出来 <small>SELECTED PROJECTS</small>
        </h2>
        <a class="text-link" href={withBase('projects/')}>
          所有项目 <Icon name="arrow" size={15} />
        </a>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    </section>
    <p class="home-signature">a little space for thoughts, and everything in between.</p>
  </div>
</Base>
