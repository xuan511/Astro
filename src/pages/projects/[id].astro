---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/paths';
import '../../styles/prose.css';
export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
const { data } = project;
---

<Base title={data.name} description={data.description}>
  <div class="shell project-detail">
    <PageHeading title={data.name} eyebrow="PROJECT JOURNAL" description={data.description}>
      <div class="project-detail-meta">
        <span class="project-status">{data.status}</span>
        <a class="button" href={data.github} target="_blank" rel="noopener noreferrer">
          在 GitHub 查看 <Icon name="external" size={15} />
        </a>
      </div>
      <div class="stack">
        {data.stack.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </PageHeading>
    {data.screenshot && (
      <Media
        src={data.screenshot}
        alt={data.screenshotAlt || `${data.name} 项目截图`}
        class="article-cover"
      />
    )}
    <article class="prose">
      <h2>关于这个项目</h2>
      {data.details.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </article>
    {data.resources.length > 0 && (
      <section class="project-resources" aria-labelledby="project-resources-title">
        <h2 id="project-resources-title">项目文档</h2>
        <ul>
          {data.resources.map((resource) => (
            <li>
              <a href={resource.url} target="_blank" rel="noopener noreferrer">
                {resource.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <a class="text-link project-detail-return" href={withBase('projects/')}>
      继续看看其他项目 <Icon name="arrow" size={15} />
    </a>
  </div>
</Base>
<style>
  .project-detail {
    max-width: var(--layout-reading);
  }
  .project-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-5);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-5);
  }
  .project-detail :global(.page-heading h1) {
    overflow-wrap: anywhere;
  }
  .project-detail-return {
    margin-top: var(--space-6);
  }
  .project-resources {
    margin-top: var(--space-6);
  }
  .project-resources a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
  }
</style>
