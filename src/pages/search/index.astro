---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import SearchPanel from '../../components/SearchPanel.astro';
import { withBase } from '../../lib/paths';
---

<Base title="搜索" description="搜索本站文章与项目。">
  <div class="shell search-page">
    <PageHeading title="搜索" />
    <SearchPanel />
    <noscript>
      <p class="notice">
        搜索需要 JavaScript。你也可以通过<a href={withBase('archive/')}>文章归档</a>按时间阅读。
      </p>
    </noscript>
  </div>
</Base>
<style>
  .search-page {
    max-width: 900px;
  }
</style>
