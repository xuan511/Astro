---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import { Content } from '../../../docs/WRITING.md';
import { withBase } from '../../lib/paths';
import '../../styles/prose.css';
---

<Base title="写作与发布指南" description="用 VS Code、Markdown 和仓库提交，持续维护 Qing Notes。">
  <div class="shell writing-page">
    <PageHeading title="写作与发布指南" />
    <p class="notice">
      从旧版升级？
      <a href={withBase('legacy/#/studio')} data-astro-reload>
        打开旧版数据恢复入口
      </a>
      ，先导出本地完整备份。
    </p>
    <article class="prose">
      <Content />
    </article>
  </div>
</Base>
<style>
  .writing-page {
    max-width: 860px;
  }
  .writing-page > .notice {
    margin-bottom: 35px;
  }
</style>
