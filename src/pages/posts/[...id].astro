---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { publishedPosts } from '../../lib/content';
import { postsWithNeighbors } from '../../lib/post-query';

export async function getStaticPaths() {
  return postsWithNeighbors(await publishedPosts()).map(({ post, previous, next }) => ({
    params: { id: post.id },
    props: { post, previous, next },
  }));
}
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout {post} {previous} {next} {headings}>
  <Content />
</PostLayout>
