---
import PostIndex from '../../layouts/PostIndex.astro';
import { publishedPosts } from '../../lib/content';
import { groupPostsByTaxonomy } from '../../lib/post-query';
export async function getStaticPaths() {
  return groupPostsByTaxonomy(await publishedPosts(), 'category').map(({ name, posts }) => ({
    params: { category: name },
    props: { category: name, posts },
  }));
}
const { category, posts } = Astro.props;
---

<PostIndex
  title={category}
  eyebrow="COLLECTION"
  description={`归在「${category}」里的文字与片刻。`}
  posts={posts}
/>
