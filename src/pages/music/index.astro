---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import PlayerMode from '../../components/PlayerMode.astro';
import { tracks } from '../../lib/music';
import { publishedScores } from '../../lib/content';
import { coverPath } from '../../lib/player-state';
import { withBase, postPath } from '../../lib/paths';
const first = tracks[0];
const scores = await publishedScores();
---

<Base title="音乐台" description="音乐播放列表与半音阶口琴谱。">
  <div class="shell">
    <PageHeading title="音乐台" />
    {first ? (
      <div class="music-room">
        <section
          class="full-player"
          data-player-controls
          tabindex="0"
          aria-label="音乐控制面板，空格播放，方向键快进快退"
        >
          <div class="record-art">
            <img
              data-player-cover="full"
              src={withBase(coverPath(first, 'full'))}
              alt="当前音乐封面"
              width="200"
              height="200"
            />
          </div>
          <h2 data-player-title>{first.title}</h2>
          <p data-player-artist>{first.artist}</p>
          <div class="player-buttons">
            <button class="icon-button" type="button" data-player-prev aria-label="上一首">
              <Icon name="prev" />
            </button>
            <button class="player-play" type="button" data-player-toggle aria-label="播放">
              <span data-play-icon>
                <Icon name="play" size={22} />
              </span>
              <span data-pause-icon hidden>
                <Icon name="pause" size={22} />
              </span>
            </button>
            <button class="icon-button" type="button" data-player-next aria-label="下一首">
              <Icon name="next" />
            </button>
          </div>
          <input
            type="range"
            min="0"
            max="1000"
            value="0"
            disabled
            data-player-seek
            aria-label="播放进度"
          />
          <div class="time-row">
            <span data-player-current>0:00</span>
            <span data-player-duration>--:--</span>
          </div>
          <div class="full-options">
            <PlayerMode id="room-play-mode" describedBy="room-mode-hint" />
            <label>
              <Icon name="volume" size={15} />
              音量
              <input
                type="range"
                min="0"
                max="1"
                step="0.01"
                value="0.55"
                data-player-volume
                aria-label="音乐页面音量"
              />
            </label>
          </div>
          <p class="sr-only" id="room-mode-hint" data-mode-hint>
            按歌单顺序播放，最后一首结束后停止。
          </p>
          <p class="player-feedback" data-player-feedback role="status"></p>
        </section>
        <section class="music-playlist" aria-labelledby="playlist-title">
          <h2 id="playlist-title">
            播放列表 <span class="count">{tracks.length} 首</span>
          </h2>
          {tracks.map((track, index) => (
            <div class="music-track-row">
              <button
                class="queue-track"
                type="button"
                data-play-track={track.id}
                aria-label={`播放 ${track.title}`}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                <img
                  src={withBase(coverPath(track, 'thumbnail'))}
                  alt=""
                  width="45"
                  height="45"
                  loading="lazy"
                />
                <span>
                  <strong>
                    {track.title} {track.demo && <span class="sample-badge">示例</span>}
                  </strong>
                  <small>{track.artist}</small>
                </span>
                <span data-track-state={track.id}>播放</span>
              </button>
            </div>
          ))}
          <details class="music-credits">
            <summary>专辑与封面来源</summary>
            <ul>
              {tracks.map((track) => (
                <li>
                  {track.sourceUrl ? (
                    <a href={track.sourceUrl} target="_blank" rel="noopener noreferrer">
                      {track.title}
                    </a>
                  ) : (
                    track.title
                  )}
                  <span>{track.album || track.artist}</span>
                </li>
              ))}
            </ul>
          </details>
        </section>
      </div>
    ) : (
      <div class="empty-state">
        <Icon name="music" size={32} />
        <h2>暂无音乐</h2>
      </div>
    )}
    {scores.length > 0 && (
      <section class="music-scores" aria-labelledby="scores-title">
        <div class="music-scores-heading">
          <h2 id="scores-title">口琴谱</h2>
          <a class="text-link" href={withBase('music/scores/')}>
            全部琴谱
          </a>
        </div>

        <ul>
          {scores.map((score) => (
            <li>
              <a href={postPath(score.id)}>{score.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
