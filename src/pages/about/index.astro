---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { withBase } from '../../lib/paths';
import '../../styles/prose.css';
---

<Base title="关于我" description={site.description}>
  <div class="shell">
    <PageHeading
      title={`你好，我是 ${site.author}。`}
      eyebrow="BEHIND THE WORDS"
      description={site.description}
    />
    <div class="about-layout">
      <aside class="about-profile">
        <img
          class="avatar"
          src={withBase(site.avatar)}
          width="100"
          height="100"
          alt={`${site.author} 的头像`}
        />
        <h2>{site.author}</h2>
        <div class="about-interests">
          {site.interests.map((interest) => (
            <span>{interest}</span>
          ))}
        </div>
        <nav aria-label="联系方式">
          {site.social.map((item) => (
            <a
              class="text-link"
              href={item.url}
              target={item.url.startsWith('http') ? '_blank' : undefined}
              rel="noopener noreferrer"
            >
              {item.label}
              <Icon name="external" size={13} />
            </a>
          ))}
        </nav>
      </aside>
      <article class="prose">
        <h2>一个可以慢慢生长的地方</h2>
        {site.about.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <h2>文字之外，也做一点东西</h2>
        <p>一些好奇心，会变成代码。已经开始的尝试与还在改进的项目，都整理在这里。</p>
        <a class="button" href={withBase('projects/')}>
          看看我的项目 <Icon name="arrow" size={15} />
        </a>
        {site.timeline.length > 0 && (
          <>
            <h2>一路走来</h2>
            <ol class="about-timeline">
              {site.timeline.map((event) => (
                <li>
                  <strong>{event.year}</strong>
                  <p>{event.text}</p>
                </li>
              ))}
            </ol>
          </>
        )}
        <blockquote>
          <p>{site.footer}</p>
        </blockquote>
      </article>
    </div>
  </div>
</Base>
<style>
  .about-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 680px);
    gap: 75px;
    max-width: 970px;
    margin: 10px auto;
  }
  .about-profile {
    text-align: center;
    padding-top: 20px;
  }
  .about-profile .avatar {
    margin: auto;
  }
  .about-profile h2 {
    font:
      26px Georgia,
      var(--serif);
    margin: 22px 0 15px;
  }
  .about-interests {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 13px;
    font-size: 11px;
    color: var(--muted);
  }
  .about-profile nav {
    border-top: 1px solid var(--line);
    padding-top: 20px;
    margin-top: 23px;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
  }
  .about-layout .prose > h2:first-child {
    margin-top: 0;
  }
  .about-timeline {
    list-style: none;
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  .about-timeline li {
    margin: 25px 0;
  }
  @media (max-width: 800px) {
    .about-layout {
      gap: 35px;
      grid-template-columns: 160px minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .about-layout {
      display: block;
    }
    .about-profile {
      padding: 0 0 28px;
      margin-bottom: 30px;
      border-bottom: 1px solid var(--line);
    }
    .about-profile .avatar {
      width: 75px;
      height: 75px;
    }
    .about-profile h2 {
      margin-top: 15px;
    }
    .about-profile nav {
      border: 0;
      padding-top: 5px;
      margin-top: 15px;
    }
  }
</style>
