---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import { recentNotes } from '../../lib/content';
import { formatDate } from '../../lib/paths';
const notes = await recentNotes();
---

<Base title="随记" description="随记。">
  <div class="shell">
    <PageHeading title="随记" />
    <div class="notes-grid">
      {notes.map((note) => (
        <article class="note-card">
          <div>
            <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
            {note.data.demo && <span class="sample-badge">示例</span>}
          </div>
          <p>{note.data.body}</p>
        </article>
      ))}
    </div>
    {notes.length === 0 && (
      <div class="empty-state">
        <h2>暂无随记</h2>
      </div>
    )}
  </div>
</Base>
<style>
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }
  .note-card {
    min-width: 0;
    padding: var(--space-5);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    min-height: 14rem;
  }
  .note-card > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .note-card time {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .note-card > p {
    font: var(--text-lg)/var(--leading-reading) var(--serif);
    white-space: pre-line;
    margin: var(--space-5) 0;
    overflow-wrap: anywhere;
    flex: 1;
  }
  .note-card > span {
    font:
      italic var(--text-xs) Georgia,
      serif;
    letter-spacing: 1px;
    color: var(--muted);
  }
</style>
