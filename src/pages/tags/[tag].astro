---
import PostIndex from '../../layouts/PostIndex.astro';
import { publishedPosts } from '../../lib/content';
import { groupPostsByTaxonomy } from '../../lib/post-query';
export async function getStaticPaths() {
  return groupPostsByTaxonomy(await publishedPosts(), 'tags').map(({ name, posts }) => ({
    params: { tag: name },
    props: { tag: name, posts },
  }));
}
const { tag, posts } = Astro.props;
---

<PostIndex
  title={`# ${tag}`}
  eyebrow="COLLECTION"
  description={`一些有关「${tag}」的记录。`}
  posts={posts}
/>
