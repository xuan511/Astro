---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import { publishedPosts } from '../../lib/content';
import { groupPostsByYear } from '../../lib/post-query';
import { postPath } from '../../lib/paths';
const posts = await publishedPosts();
const years = groupPostsByYear(posts);
---

<Base title="归档" description="所有技术博客与生活随笔，按时间慢慢翻阅。">
  <div class="shell">
    <PageHeading
      title="时光的目录"
      eyebrow="THE ARCHIVE"
      description={`${posts.length} 篇记录，都是来过的痕迹。`}
    />
    {years.map(({ year, entries }) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <div>
          {entries.map(({ post, date }) => (
            <a class="archive-entry" href={postPath(post.id)}>
              <time datetime={post.data.publishedAt.toISOString()}>
                {date.month} / {date.day}
              </time>
              <h3>{post.data.title}</h3>
              {post.data.demo && <span class="sample-badge">示例</span>}
              <Icon name="arrow" size={17} />
            </a>
          ))}
        </div>
      </section>
    ))}
    {posts.length === 0 && (
      <div class="empty-state">
        <h2>从第一篇开始。</h2>
      </div>
    )}
  </div>
</Base>
<style>
  .archive-year {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-7);
    margin-block: var(--space-7);
    align-items: start;
  }
  .archive-year > h2 {
    font:
      500 var(--text-2xl) / var(--leading-title) Georgia,
      var(--serif);
    color: var(--muted);
  }
  .archive-entry {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-fast),
      background-color var(--duration-fast);
  }
  .archive-entry:hover {
    color: var(--accent);
    background: var(--soft);
  }
  .archive-entry time {
    font-size: var(--text-xs);
    color: var(--muted);
    white-space: nowrap;
  }
  .archive-entry h3 {
    min-width: 0;
    overflow-wrap: anywhere;
    font: 500 var(--text-lg)/1.6 var(--serif);
    flex: 1;
  }
  .archive-entry :global(svg) {
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .archive-year {
      display: block;
      margin-block: var(--space-6);
    }
    .archive-year > h2 {
      margin-bottom: var(--space-2);
    }
    .archive-entry {
      gap: var(--space-3);
      padding-block: var(--space-4);
    }
    .archive-entry :global(svg) {
      display: none;
    }
  }
</style>
