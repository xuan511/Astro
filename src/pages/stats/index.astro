---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import VisitCount from '../../components/VisitCount.astro';
import { analytics } from '../../config/analytics';
import { publishedPosts } from '../../lib/content';
import { groupPostsByTaxonomy } from '../../lib/post-query';
import { taxonomyPath } from '../../lib/paths';
const posts = await publishedPosts();
const groups = groupPostsByTaxonomy(posts, 'category');
---

<Base title="访问统计" description="Qing Notes 的累计访问、今日访问与内容分布。" section="stats/">
  <div class="shell statistics-page">
    <PageHeading title="访问统计" />
    <div class="statistics-grid">
      <section>
        <h2>累计访问量</h2>
        <VisitCount metric="site_pv" label="" />
      </section>
      <section>
        <h2>累计访客数（估算）</h2>
        <VisitCount metric="site_uv" label="" unit="位" />
      </section>
      <section>
        <h2>今日访问量</h2>
        <VisitCount metric="today_pv" label="" />
      </section>
      <section>
        <h2>今日访客数（估算）</h2>
        <VisitCount metric="today_uv" label="" unit="位" />
      </section>
    </div>
    <p class="statistics-status" data-visit-status role="status" aria-live="polite">
      正在读取访问统计
    </p>
    <section class="statistics-content">
      <h2>{posts.length} 篇已发布记录</h2>
      <nav aria-label="内容分类分布">
        {groups.map((group) => (
          <a href={taxonomyPath('categories', group.name)}>
            <span>{group.name}</span>
            <strong>{group.posts.length}</strong>
          </a>
        ))}
      </nav>
    </section>
    <section class="statistics-source">
      <h2>统计信息</h2>
      <dl>
        <div>
          <dt>服务</dt>
          <dd>
            <a href={analytics.providerUrl} target="_blank" rel="noopener noreferrer">
              {analytics.provider}
            </a>
          </dd>
        </div>
        <div>
          <dt>接入日期</dt>
          <dd>{analytics.introducedAt}</dd>
        </div>
      </dl>
    </section>
  </div>
</Base>
