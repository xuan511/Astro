{
  "name": "shijian-journal",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4173",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:built": "node scripts/verify-build.mjs",
    "verify": "npm run check && npm run format:check && npm test && npm run build && npm run test:built",
    "verify:pages": "node scripts/check-pages.mjs",
    "new:post": "node scripts/new-post.mjs",
    "import:backup": "node scripts/import-backup.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "katex": "0.19.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "~5.9.3"
  }
}
